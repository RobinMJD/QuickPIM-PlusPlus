{
  "name": "quickpim-plusplus",
  "version": "2.17.4",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "scripts": {
    "type-check": "tsc --noEmit",
    "check:edge": "node scripts/check-edge-compatibility.mjs",
    "build": "tsc --noEmit && vite build",
    "assets:stores": "node scripts/generate-store-assets.mjs",
    "package:stores": "node scripts/package-stores.mjs",
    "test": "vitest run --maxWorkers=1 --no-file-parallelism",
    "test:edge": "node scripts/smoke-edge-extension.mjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.0.312",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^26.0.0",
    "typescript": "^5.8.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
